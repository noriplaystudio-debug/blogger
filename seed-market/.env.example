# Copy to .env.local. Never commit real credentials.
# Existing Sites hosting keeps platform-owned ChatGPT authentication.
# AUTH_MODE=better-auth is for the independent Node authentication adapter.
AUTH_MODE=sites
BETTER_AUTH_URL=http://127.0.0.1:4173
BETTER_AUTH_SECRET=
AUTH_DATABASE_PATH=.sites-runtime/auth.sqlite
APP_DATABASE_PATH=.sites-runtime/market.sqlite

# Register each callback: <BETTER_AUTH_URL>/api/auth/callback/<provider>
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email/password stays disabled until verification/reset mail is connected.
AUTH_EMAIL_ENABLED=false
AUTH_MAIL_WEBHOOK_URL=
AUTH_MAIL_WEBHOOK_SECRET=

# Server-owned administrator IDs, comma separated. Never a browser role.
ADMIN_USER_IDS=
PAYMENTS_MODE=test

# Future KIPRIS Plus connection: server-only key, after service/product approval.
# This version stays in manual review mode; a key does NOT enable automatic lookup.
# No private idea text or files are automatically sent to KIPRIS.
KIPRIS_PLUS_API_KEY=
KIPRIS_PLUS_PRODUCT_APPROVED=false
